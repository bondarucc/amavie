generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id        String    @id @default(uuid())
  title     String
  template  Templates
  assets    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Templates {
  Template1
  Template2
}

enum ModelType {
  Trousers
  Jeans
  Shorts
  Shirt
  Blouse
  TShirt
  Dress
  Skirt
  Jacket
  Coat
  Sweater
  Cardigan
  Accessory
}

enum SizeType {
  Letter
  Numeric
  Dimension
}

enum ModelSeason {
  Winter
  Summer
  MidSeason
}

model Model {
  id             String        @id @default(uuid())
  type           ModelType
  name           String        @unique
  sizeType       SizeType
  season         ModelSeason
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]
  primaryImageId String?       @unique
  primaryImage   ProductImage? @relation("ModelPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)

  @@index([type])
}

model Product {
  id          String         @id @default(uuid())
  externalId  String         @unique
  description String
  fabric      String
  colors      ProductColor[]
  model       Model          @relation(fields: [modelId], references: [id])
  modelId     String
}

model ColorDefinition {
  id              String         @id @default(uuid())
  displayValue    String
  normalizedValue String         @unique
  hex             String
  productColors   ProductColor[]

  @@index([displayValue])
}

model ProductColor {
  id                String          @id @default(uuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorDefinitionId String
  colorDefinition   ColorDefinition @relation(fields: [colorDefinitionId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]

  @@unique([productId, colorDefinitionId])
  @@index([colorDefinitionId])
}

model ProductVariant {
  id             String           @id @default(uuid())
  productColorId String
  productColor   ProductColor     @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  size           String
  stocks         WarehouseStock[]

  @@unique([productColorId, size])
}

enum WarehouseStockImportState {
  draft
  applied
}

enum WarehouseStockImportSnapshotState {
  NOT_MATCHED
  UNTOUCHED
  MISSING_INPUT
  MODIFIED
}

model Warehouse {
  id      String                  @id @default(uuid())
  name    String                  @unique
  stocks  WarehouseStock[]
  imports WarehouseStockImport[]
}

model WarehouseStock {
  id               String                         @id @default(uuid())
  stock            Int                            @default(0)
  productVariantId String
  productVariant   ProductVariant                 @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  importSnapshots  WarehouseStockImportSnapshot[]

  @@unique([productVariantId, warehouseId])
  @@index([warehouseId])
}

model WarehouseStockImport {
  id          String                         @id @default(uuid())
  warehouseId String
  warehouse   Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  filename    String
  state       WarehouseStockImportState      @default(draft)
  appliedAt   DateTime?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  snapshots   WarehouseStockImportSnapshot[]

  @@index([warehouseId])
}

model WarehouseStockImportSnapshot {
  id               String                              @id @default(uuid())
  importId         String
  import           WarehouseStockImport                @relation(fields: [importId], references: [id], onDelete: Cascade)
  warehouseStockId String?
  warehouseStock   WarehouseStock?                     @relation(fields: [warehouseStockId], references: [id])
  previousStock    Int?
  newStock         Int?
  externalId       String
  size             String
  color            String
  modelName        String?
  state            WarehouseStockImportSnapshotState

  @@index([importId])
  @@index([warehouseStockId])
}

model ProductImage {
  id             String       @id
  filename       String
  productColorId String
  productColor   ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  primaryForModel Model?      @relation("ModelPrimaryImage")
  createdAt      DateTime     @default(now())

  @@index([productColorId])
}
