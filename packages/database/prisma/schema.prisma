generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id        String    @id @default(uuid())
  title     String
  template  Templates
  assets    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Templates {
  Template1
  Template2
}

enum ModelType {
  Trousers
  Jeans
  Shorts
  Shirt
  Blouse
  TShirt
  Dress
  Skirt
  Jacket
  Coat
  Sweater
  Cardigan
  Accessory
}

enum SizeType {
  Letter
  Numeric
  Dimension
}

model Model {
  id        String    @id @default(uuid())
  type      ModelType
  name      String    @unique
  sizeType  SizeType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([type])
}

model Product {
  id          String           @id @default(uuid())
  externalId  String           @unique
  description String
  fabric      String
  variants    ProductVariant[]
  images      ProductImage[]
  model       Model            @relation(fields: [modelId], references: [id])
  modelId     String
}

model ProductVariant {
  id        String           @id @default(uuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  size      String
  color     String
  stocks    WarehouseStock[]

  @@unique([productId, size, color])
}

enum WarehouseStockImportState {
  draft
  applied
}

enum WarehouseStockImportSnapshotState {
  NOT_MATCHED
  UNTOUCHED
  MISSING_INPUT
  MODIFIED
}

model Warehouse {
  id      String                  @id @default(uuid())
  name    String                  @unique
  stocks  WarehouseStock[]
  imports WarehouseStockImport[]
}

model WarehouseStock {
  id               String                         @id @default(uuid())
  stock            Int                            @default(0)
  productVariantId String
  productVariant   ProductVariant                 @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  importSnapshots  WarehouseStockImportSnapshot[]

  @@unique([productVariantId, warehouseId])
  @@index([warehouseId])
}

model WarehouseStockImport {
  id          String                         @id @default(uuid())
  warehouseId String
  warehouse   Warehouse                      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  filename    String
  state       WarehouseStockImportState      @default(draft)
  appliedAt   DateTime?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  snapshots   WarehouseStockImportSnapshot[]

  @@index([warehouseId])
}

model WarehouseStockImportSnapshot {
  id               String                              @id @default(uuid())
  importId         String
  import           WarehouseStockImport                @relation(fields: [importId], references: [id], onDelete: Cascade)
  warehouseStockId String?
  warehouseStock   WarehouseStock?                     @relation(fields: [warehouseStockId], references: [id])
  previousStock    Int?
  newStock         Int?
  externalId       String
  size             String
  color            String
  modelName        String?
  state            WarehouseStockImportSnapshotState

  @@index([importId])
  @@index([warehouseStockId])
}

model ProductImage {
  id        String   @id
  filename  String
  color     String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, color])
}
