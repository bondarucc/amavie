generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id        String    @id @default(uuid())
  title     String
  template  Templates
  assets    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Templates {
  Template1
  Template2
}

enum ModelType {
  Trousers
  Jeans
  Shorts
  Shirt
  Blouse
  TShirt
  Dress
  Skirt
  Jacket
  Coat
  Sweater
  Cardigan
  Accessory
}

enum SizeType {
  Letter
  Numeric
  Dimension
}

model Model {
  id        String    @id @default(uuid())
  type      ModelType
  name      String    @unique
  sizeType  SizeType
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([type])
}

model Product {
  id          String           @id @default(uuid())
  externalId  String           @unique
  description String
  fabric      String
  variants    ProductVariant[]
  model       Model            @relation(fields: [modelId], references: [id])
  modelId     String
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String
  color     String
  stock     Int     @default(0)

  @@unique([productId, size, color])
}
